{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Knowledge Graph TOML Schema",
  "description": "Schema for defining nodes and relations in a knowledge graph using TOML format.",
  "type": "object",
  "definitions": {
    "property": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the property."
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "integer",
            "float",
            "floating",
            "boolean",
            "datetime",
            "enum",
            "array",
            "json_string"
          ],
          "description": "Data type of the property."
        },
        "optional": {
          "type": "boolean",
          "description": "Indicates whether the property is optional."
        },
        "description": {
          "type": "string",
          "description": "Description of the property."
        },
        "enum_values": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Allowed values when type is enum."
        }
      },
      "required": [
        "name",
        "type",
        "optional"
      ],
      "if": {
        "properties": {
          "type": {
            "const": "enum"
          }
        }
      },
      "then": {
        "required": [
          "enum_values"
        ]
      }
    }
  },
  "properties": {
    "title": {
      "type": "string",
      "description": "Title of the schema document."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$",
      "description": "Schema version (e.g., 1.0 or 1.0.0)."
    },
    "node": {
      "type": "object",
      "description": "Definitions of node labels and their properties.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "node_description": {
            "type": "string",
            "description": "Textual description of the node label."
          },
          "primary_key": {
            "type": "string",
            "description": "Property used as the MERGE key during ingestion."
          },
          "node_properties": {
            "type": "array",
            "description": "List of properties associated with this node label.",
            "items": {
              "$ref": "#/definitions/property"
            }
          }
        },
        "required": [
          "node_description"
        ]
      }
    },
    "relation": {
      "type": "object",
      "description": "Definitions of relation types and their properties.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "relation_description": {
            "type": "string",
            "description": "Textual description of the relation."
          },
          "from_entity": {
            "type": "string",
            "description": "Label of the source node in the relation."
          },
          "to_entity": {
            "type": "string",
            "description": "Label of the target node in the relation."
          },
          "relation_properties": {
            "type": "array",
            "description": "List of properties associated with this relation.",
            "items": {
              "$ref": "#/definitions/property"
            }
          }
        },
        "required": [
          "relation_description",
          "from_entity",
          "to_entity"
        ]
      }
    }
  },
  "required": [
    "title",
    "version",
    "node"
  ]
}
