{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RunManifest",
  "description": "Run manifest assembled at Stage G. Summarises pipeline configuration, artifact inventory, primary conclusion, and review hooks for the completed run.",
  "type": "object",
  "additionalProperties": true,
  "required": ["run_id", "completed_at", "input_refs", "pipeline_config", "artifacts", "review_hooks", "pipeline_health", "ap913_completeness"],

  "properties": {
    "run_id":       { "type": "string", "description": "Matches the run_context.run_id for this run." },
    "completed_at": { "type": "string", "format": "date-time" },

    "input_refs": {
      "type": "object",
      "additionalProperties": true,
      "required": ["event_id", "asset_id"],
      "properties": {
        "event_id":  { "type": ["string", "null"] },
        "asset_id":  { "type": ["string", "null"] }
      }
    },

    "pipeline_config": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "causality_engine_version":          { "type": "string" },
        "evidence_refinement_applied":       { "type": "boolean" },
        "causality_pre_refine_persisted":    { "type": "boolean" },
        "enable_ishikawa":                   { "type": "boolean" },
        "ishikawa_run":                      { "type": "boolean", "description": "True when Ishikawa matrix was produced for this run." },
        "ishikawa_skip_reason":              { "type": ["string", "null"], "description": "Populated when ishikawa_run is false; explains why Ishikawa was not performed." },
        "top_k_candidates":                  { "type": "integer" },
        "top_k_evidence":                    { "type": "integer" },
        "scoring_evolution": {
          "type": ["array", "null"],
          "description": "v1→v2 candidate ranking delta rows, sorted by |rank_post - rank_pre|.",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["candidate_id"],
            "properties": {
              "candidate_id":         { "type": "string" },
              "rank_pre_refine":      { "type": ["integer", "null"] },
              "rank_post_refine":     { "type": ["integer", "null"] },
              "composite_pre":        { "type": ["number", "null"] },
              "composite_post":       { "type": ["number", "null"] },
              "evidence_score_pre":   { "type": ["number", "null"] },
              "evidence_score_post":  { "type": ["number", "null"] },
              "evidence_posture_post":{ "type": ["string", "null"] }
            }
          }
        },
        "reentry_execution": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "auto_reentry_enabled": { "type": "boolean" },
            "attempt_count": { "type": "integer", "minimum": 0 },
            "attempts": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
          }
        }
      }
    },

    "artifacts": {
      "type": "object",
      "description": "Inventory of artifacts produced by this run.",
      "additionalProperties": true,
      "properties": {
        "kg_context":                   { "type": "object", "properties": { "present": { "type": "boolean" } } },
        "tskr_patterns":                { "type": "object" },
        "causality_candidates":         { "type": "object" },
        "causality_candidates_pre_refine": { "type": "object" },
        "evidence_bundle":              { "type": "object" },
        "ishikawa_matrix":              { "type": "object" },
        "barrier_analysis":             { "type": "object" },
        "reentry_execution":            { "type": "object" },
        "workflow_dispatch": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "present": { "type": "boolean" },
            "dispatched": { "type": "boolean" },
            "target_queue": { "type": ["string", "null"] },
            "transport_status": { "type": ["string", "null"] }
          }
        },
        "cmms_context":                 { "type": "object" },
        "rca_card":                     { "type": "object" }
      }
    },

    "primary_conclusion": {
      "type": "object",
      "description": "Compact summary of the primary hypothesis conclusion.",
      "additionalProperties": true,
      "properties": {
        "candidate_id":    { "type": ["string", "null"] },
        "cause_label":     { "type": ["string", "null"] },
        "confidence_label":{ "type": ["string", "null"], "enum": ["high", "medium", "low", "speculative", null] },
        "decision_status": { "type": ["string", "null"] }
      }
    },

    "review_hooks": {
      "type": "object",
      "description": "Computed signals for analyst review routing.",
      "additionalProperties": true,
      "required": ["writeback_ready", "next_step"],
      "properties": {
        "writeback_ready":       { "type": "boolean" },
        "requires_human_review": { "type": "boolean" },
        "next_step": {
          "type": "string",
          "enum": ["writeback", "analyst_review", "validation_remediation"]
        },
        "degraded_run": { "type": "boolean" },
        "degraded_reasons": { "type": "array", "items": { "type": "string" } },
        "reentry_hook": { "type": "object", "additionalProperties": true },
        "workflow_dispatch": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "dispatch_enabled": { "type": "boolean" },
            "dispatched": { "type": "boolean" },
            "target_queue": { "type": ["string", "null"] },
            "dispatch_ref": { "type": ["string", "null"] },
            "transport_status": { "type": ["string", "null"] },
            "transport_ref": { "type": ["string", "null"] }
          }
        },
        "hard_abort_on_kg_red_state": { "type": "boolean" },
        "hard_abort_required": { "type": "boolean" }
      }
    },
    "pipeline_health": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "issues"],
      "properties": {
        "status": { "type": "string", "enum": ["green", "yellow", "red"] },
        "issues": { "type": "array", "items": { "type": "string" } }
      }
    },
    "stage_health": {
      "type": "object",
      "additionalProperties": true
    },
    "kg_governance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "issues", "failure_mode_count", "min_failure_modes_required"],
      "properties": {
        "status": { "type": "string", "enum": ["green", "yellow", "red"] },
        "issues": { "type": "array", "items": { "type": "string" } },
        "failure_mode_count": { "type": "integer", "minimum": 0 },
        "min_failure_modes_required": { "type": "integer", "minimum": 0 }
      }
    },
    "barrier_analysis": {
      "type": "object",
      "additionalProperties": true,
      "required": ["summary"],
      "properties": {
        "summary": {
          "type": "object",
          "additionalProperties": true,
          "required": ["overall_status", "barrier_count", "degraded_barrier_count"],
          "properties": {
            "overall_status": { "type": "string", "enum": ["green", "yellow", "red"] },
            "barrier_count": { "type": "integer", "minimum": 0 },
            "degraded_barrier_count": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "ap913_completeness": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "root_cause_identified",
        "direct_cause_identified",
        "contributing_causes_identified",
        "extent_of_condition_assessed",
        "effectiveness_review_defined"
      ],
      "properties": {
        "root_cause_identified": { "type": "boolean" },
        "direct_cause_identified": { "type": "boolean" },
        "contributing_causes_identified": { "type": "boolean" },
        "extent_of_condition_assessed": { "type": "boolean" },
        "effectiveness_review_defined": { "type": "boolean" }
      }
    },

    "validation": {
      "type": "object",
      "description": "Input and output validation reports.",
      "additionalProperties": true
    }
  }
}
