{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReentryExecution",
  "description": "Execution record for bounded automatic re-entry attempts triggered by rank inversion.",
  "type": "object",
  "additionalProperties": true,
  "required": ["auto_reentry_enabled", "attempt_count", "attempts", "reentry_hook"],
  "properties": {
    "auto_reentry_enabled": { "type": "boolean" },
    "attempt_count": { "type": "integer", "minimum": 0 },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "reentry_hook": {
      "type": "object",
      "additionalProperties": true,
      "required": ["should_reenter", "reason"],
      "properties": {
        "should_reenter": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "kg_governance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "issues"],
      "properties": {
        "status": { "type": "string", "enum": ["green", "yellow", "red"] },
        "issues": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
