{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VendorSupplyChainRecords",
  "description": "Vendor and supply-chain records used for Category K assessments (certifications, lot traceability, receipt inspections).",
  "type": "object",
  "additionalProperties": false,
  "required": ["supply_chain_context_id", "event_id", "asset_id", "generated_at", "parts"],
  "properties": {
    "supply_chain_context_id": { "type": "string" },
    "event_id": { "type": "string" },
    "asset_id": { "type": ["string", "null"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["part_id", "component_id", "vendor_name"],
        "properties": {
          "part_id": { "type": "string" },
          "component_id": { "type": "string" },
          "part_number": { "type": ["string", "null"] },
          "vendor_name": { "type": "string" },
          "vendor_id": { "type": ["string", "null"] },
          "lot_number": { "type": ["string", "null"] },
          "serial_number": { "type": ["string", "null"] },
          "manufacture_date": { "type": ["string", "null"], "format": "date-time" },
          "received_date": { "type": ["string", "null"], "format": "date-time" },
          "certifications": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cert_type", "status"],
              "properties": {
                "cert_type": { "type": "string" },
                "cert_id": { "type": ["string", "null"] },
                "status": { "type": "string", "enum": ["valid", "expired", "revoked", "unknown"] },
                "issued_at": { "type": ["string", "null"], "format": "date-time" },
                "expires_at": { "type": ["string", "null"], "format": "date-time" }
              }
            }
          },
          "receipt_inspections": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["inspection_id", "status", "inspected_at"],
              "properties": {
                "inspection_id": { "type": "string" },
                "status": { "type": "string", "enum": ["pass", "fail", "conditional", "unknown"] },
                "inspected_at": { "type": "string", "format": "date-time" },
                "inspector": { "type": ["string", "null"] },
                "notes": { "type": "string" },
                "nonconformance_refs": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "supplier_deviation_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coverage_status": { "type": "string", "enum": ["complete", "partial", "missing"] },
        "quality_flags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["generated_by"],
      "properties": {
        "generated_by": { "type": "string" }
      }
    }
  }
}
