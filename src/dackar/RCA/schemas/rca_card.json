{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rca_card.v3_1.schema.json",
  "title": "RCACard",
  "description": "Final synthesized RCA card produced from structured reasoning artifacts, evidence retrieval, and constrained LLM synthesis.",
  "type": "object",
  "required": [
    "rca_id",
    "event_id",
    "generated_at",
    "llm_model",
    "validation_status",
    "executive_summary",
    "primary_hypothesis",
    "contributing_causes",
    "evidence",
    "recommended_actions",
    "analyst_review",
    "provenance"
  ],
  "properties": {
    "rca_id": {
      "type": "string",
      "description": "Unique RCA card identifier."
    },
    "event_id": {
      "type": "string",
      "description": "Target abnormal event identifier."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the RCA card was generated."
    },
    "llm_model": {
      "type": "string",
      "description": "LLM model used for synthesis."
    },
    "input_artifacts": {
      "type": "object",
      "description": "References to key input artifacts used during synthesis.",
      "properties": {
        "event_id": {
          "type": "string"
        },
        "bundle_id": {
          "type": "string"
        },
        "evidence_bundle_id": {
          "type": "string"
        },
        "candidates_ref": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "validation_status": {
      "type": "object",
      "required": [
        "schema_valid",
        "all_claims_cited",
        "passed_minimum_evidence_gate",
        "validation_errors",
        "retry_count",
        "fallback_used"
      ],
      "properties": {
        "schema_valid": {
          "type": "boolean"
        },
        "all_claims_cited": {
          "type": "boolean"
        },
        "passed_minimum_evidence_gate": {
          "type": "boolean"
        },
        "validation_errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0
        },
        "fallback_used": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "executive_summary": {
      "type": "object",
      "description": "Analyst-facing summary of the current RCA conclusion and review posture.",
      "required": [
        "decision_status",
        "primary_conclusion",
        "confidence_label",
        "analyst_attention_flags"
      ],
      "properties": {
        "decision_status": {
          "type": "string",
          "enum": [
            "review_required",
            "candidate_ready",
            "insufficient_evidence"
          ]
        },
        "primary_conclusion": {
          "type": "string"
        },
        "confidence_label": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "speculative"
          ]
        },
        "analyst_attention_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "category_coverage_flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "external_oe_unavailable": {
          "type": "boolean"
        },
        "conclusion_type": {
          "type": "string",
          "enum": [
            "hypothesis_supported",
            "hypothesis_speculative",
            "no_adequate_hypothesis"
          ],
          "description": "Epistemic standing of the RCA conclusion. hypothesis_supported: primary candidate is A-series with non-trivial evidence posture. hypothesis_speculative: primary is B-series or all candidates have zero telemetry signal. no_adequate_hypothesis: no candidate met minimum requirements or all evidence is absent — treat the card as a review placeholder, not a conclusion."
        },
        "causal_depth_summary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "proximate_cause": { "type": "string" },
            "contributing_causes": { "type": "array", "items": { "type": "string" } },
            "root_cause": { "type": "string" },
            "depth_complete": { "type": "boolean" },
            "depth_incomplete_reason": {
              "type": "string",
              "description": "Present when depth_complete=false. Explains which depth layer is unresolved and what data or causal evidence would complete it."
            }
          }
        },
        "unresolved_gaps": {
          "type": "array",
          "items": { "type": "string" }
        },
        "effectiveness_monitoring_plan": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["linked_action_id", "indicator", "threshold", "review_horizon"],
            "properties": {
              "linked_action_id":   { "type": "string" },
              "causal_depth_level": {
                "type": "string",
                "enum": ["proximate", "contributing", "root"],
                "description": "Which causal depth layer this monitoring item addresses."
              },
              "indicator":          { "type": "string" },
              "threshold":          { "type": "string" },
              "review_horizon":     { "type": "string" },
              "success_criteria":   {
                "type": "string",
                "description": "Measurable criterion that closes this monitoring item when met."
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "primary_hypothesis": {
      "type": "object",
      "required": [
        "candidate_id",
        "cause_label",
        "hypothesis_type",
        "narrative",
        "why_primary",
        "uncertainties",
        "composite_score",
        "confidence_label",
        "citations"
      ],
      "properties": {
        "candidate_id": {
          "type": "string"
        },
        "cause_label": {
          "type": "string"
        },
        "hypothesis_type": {
          "type": "string",
          "description": "Hypothesis type copied or derived from the selected causality candidate."
        },
        "fm_id": {
          "type": ["string", "null"]
        },
        "narrative": {
          "type": "string",
          "description": "Human-readable explanation of the selected primary hypothesis."
        },
        "why_primary": {
          "type": "array",
          "description": "Explicit reasons this hypothesis is ranked above alternatives.",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "uncertainties": {
          "type": "array",
          "description": "Known uncertainties, unresolved contradictions, or missing evidence relevant to the primary hypothesis.",
          "items": {
            "type": "string"
          }
        },
        "composite_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence_label": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "speculative"
          ]
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "claim_summary",
              "source_type",
              "source_id",
              "excerpt"
            ],
            "properties": {
              "claim_summary": {
                "type": "string"
              },
              "source_type": {
                "type": "string",
                "enum": [
                  "kg_path",
                  "evidence_snippet",
                  "telemetry_anomaly",
                  "fmea_record",
                  "pm_check",
                  "operational_context"
                ]
              },
              "source_id": {
                "type": "string"
              },
              "excerpt": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "alternatives": {
      "type": "array",
      "description": "Alternative non-primary hypotheses considered during synthesis.",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "cause_label",
          "hypothesis_type",
          "composite_score",
          "confidence_label",
          "reason_not_primary"
        ],
        "properties": {
          "candidate_id": {
            "type": "string"
          },
          "cause_label": {
            "type": "string"
          },
          "hypothesis_type": {
            "type": "string"
          },
          "composite_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence_label": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low",
              "speculative"
            ]
          },
          "reason_not_primary": {
            "type": "string"
          },
          "supports": {
            "type": "array",
            "description": "Short statements describing what supports this alternative.",
            "items": {
              "type": "string"
            }
          },
          "weaknesses": {
            "type": "array",
            "description": "Short statements describing what weakens this alternative.",
            "items": {
              "type": "string"
            }
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "contributing_causes": {
      "type": "array",
      "description": "Contributing mechanisms that are causally relevant but not selected as the primary hypothesis.",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "cause_label",
          "contribution_type",
          "rationale",
          "citations"
        ],
        "properties": {
          "candidate_id": {
            "type": "string"
          },
          "cause_label": {
            "type": "string"
          },
          "contribution_type": {
            "type": "string",
            "enum": [
              "contributing",
              "enabling",
              "escalating"
            ]
          },
          "rationale": {
            "type": "string"
          },
          "citations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "description": "Evidence records included in the RCA card for traceability.",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "source_type",
          "source_id",
          "summary",
          "excerpt"
        ],
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "kg_path",
              "evidence_snippet",
              "telemetry_anomaly",
              "fmea_record",
              "pm_check",
              "operational_context"
            ]
          },
          "source_id": {
            "type": "string"
          },
          "doc_id": {
            "type": "string"
          },
          "authority_level": {
            "type": "string",
            "enum": [
              "mandatory",
              "guidance",
              "informational",
              "unknown"
            ]
          },
          "support_role": {
            "type": "string",
            "description": "How this evidence is being used in the RCA card.",
            "enum": [
              "supporting",
              "contextual",
              "contradicting",
              "missing"
            ]
          },
          "linked_candidate_id": {
            "type": "string",
            "description": "Candidate hypothesis this evidence most directly relates to, if applicable."
          },
          "summary": {
            "type": "string"
          },
          "excerpt": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "recommended_actions": {
      "type": "array",
      "description": "Recommended next actions tied to the RCA output.",
      "items": {
        "type": "object",
        "required": [
          "action_id",
          "action_type",
          "description",
          "priority"
        ],
        "properties": {
          "action_id": {
            "type": "string"
          },
          "action_type": {
            "type": "string",
            "enum": [
              "immediate_corrective",
              "long_term_corrective",
              "preventive",
              "monitoring",
              "procedure_update",
              "engineering_evaluation",
              "pm_corrective"
            ]
          },
          "description": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "target_component_id": {
            "type": "string"
          },
          "linked_candidate_id": {
            "type": "string"
          },
          "target_causal_depth": {
            "type": "string",
            "enum": ["proximate", "contributing", "root"],
            "description": "Which causal-depth layer this action primarily addresses."
          },
          "rationale": {
            "type": "string",
            "description": "Why this action is recommended."
          },
          "expected_observation_if_true": {
            "type": "string",
            "description": "What observation or result would strengthen the linked hypothesis if this action is taken."
          },
          "owner": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "analyst_review": {
      "type": "object",
      "description": "Explicit analyst review gates and unresolved decision items.",
      "required": [
        "decision_required",
        "questions_to_resolve",
        "writeback_recommendation"
      ],
      "properties": {
        "decision_required": {
          "type": "boolean"
        },
        "questions_to_resolve": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "writeback_recommendation": {
          "type": "string",
          "enum": [
            "hold_until_review",
            "ready_if_accepted"
          ]
        }
      },
      "additionalProperties": false
    },
    "ccf_summary": {
      "type": "object",
      "description": "Common-cause failure summary block. Emitted when ≥2 candidates form a plausible common-cause cluster (suspected_ccf=true) or when any common-cause signal is present. Absence of this block means no common-cause signal was detected.",
      "additionalProperties": false,
      "required": ["suspected_ccf", "ccf_confidence", "shared_mechanism_ids", "affected_trains", "affected_candidate_ids", "rationale"],
      "properties": {
        "suspected_ccf": {
          "type": "boolean",
          "description": "True when ≥2 candidates with medium/high CCF confidence share a plausible common mechanism and the top CCF score ≥ 0.45."
        },
        "ccf_confidence": {
          "type": "string",
          "enum": ["none", "low", "medium", "high"],
          "description": "Confidence derived from the highest common-cause score among clustered candidates."
        },
        "shared_mechanism_ids": {
          "type": "array",
          "items": { "type": "string" },
          "description": "KG node IDs of shared dependency or upstream components driving the CCF signal."
        },
        "affected_trains": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Train IDs that are out-of-service and linked to clustered CCF candidates, if known."
        },
        "affected_candidate_ids": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Candidate IDs that form the common-cause cluster."
        },
        "rationale": {
          "type": "string",
          "description": "Analyst-facing narrative summarising the CCF signal and recommended scope of investigation."
        }
      }
    },
    "barrier_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall_status", "degraded_barrier_count", "key_degraded_barriers"],
      "properties": {
        "overall_status": { "type": "string", "enum": ["green", "yellow", "red"] },
        "degraded_barrier_count": { "type": "integer", "minimum": 0 },
        "key_degraded_barriers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["barrier_id", "barrier_label", "barrier_type"],
            "properties": {
              "barrier_id": { "type": "string" },
              "barrier_label": { "type": "string" },
              "barrier_type": { "type": "string" }
            }
          }
        }
      }
    },
    "human_performance_assessment": {
      "type": "object",
      "description": "Step 6 human and organizational performance assessment. Populated when any H/I/J/K category candidate is retained.",
      "additionalProperties": false,
      "required": ["applicable", "category_flags", "findings", "provenance_note"],
      "properties": {
        "applicable": {
          "type": "boolean",
          "description": "True when at least one H/I/J/K candidate is retained in the card."
        },
        "category_flags": {
          "type": "object",
          "description": "Which human/org causal categories (H, I, J, K) are present among retained candidates.",
          "additionalProperties": false,
          "properties": {
            "H": { "type": "boolean", "description": "Maintenance / work-practice error" },
            "I": { "type": "boolean", "description": "Procedure inadequacy" },
            "J": { "type": "boolean", "description": "Training / qualification gap" },
            "K": { "type": "boolean", "description": "Supervision / organisational factor" }
          }
        },
        "findings": {
          "type": "array",
          "description": "One structured finding per retained H/I/J/K candidate.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["candidate_id", "causal_category", "cause_label", "confidence_label", "performance_mode"],
            "properties": {
              "candidate_id":      { "type": "string" },
              "causal_category":   { "type": "string", "enum": ["H", "I", "J", "K"] },
              "cause_label":       { "type": "string" },
              "confidence_label":  { "type": "string" },
              "performance_mode":  {
                "type": "string",
                "description": "Human performance mode inferred from category (e.g. execution_error, knowledge_gap, procedure_gap, supervisory_gap).",
                "enum": ["execution_error", "procedure_gap", "knowledge_gap", "supervisory_gap", "unknown"]
              },
              "corrective_action_ids": {
                "type": "array",
                "items": { "type": "string" },
                "description": "IDs of recommended_actions[] that address this finding."
              },
              "regulatory_reference": {
                "type": "string",
                "description": "Optional AP-913 / 10 CFR reference relevant to this human performance category."
              }
            }
          }
        },
        "provenance_note": {
          "type": "string",
          "description": "Explanation when applicable=false or when human-performance data is limited."
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "pipeline_version",
        "generated_by"
      ],
      "properties": {
        "source_bundle_id": {
          "type": "string"
        },
        "pipeline_version": {
          "type": "string"
        },
        "generated_by": {
          "type": "string"
        },
        "card_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}