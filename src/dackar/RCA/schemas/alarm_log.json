{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AlarmLog",
  "description": "Alarm/event annunciation records for an RCA analysis window.",
  "type": "object",
  "additionalProperties": false,
  "required": ["alarm_log_id", "event_id", "asset_id", "window", "generated_at", "alarms"],
  "properties": {
    "alarm_log_id": { "type": "string" },
    "event_id": { "type": "string" },
    "asset_id": { "type": ["string", "null"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "alarms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alarm_id", "timestamp", "priority", "state"],
        "properties": {
          "alarm_id": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" },
          "description": { "type": "string" },
          "priority": { "type": "string", "enum": ["critical", "high", "medium", "low", "informational", "unknown"] },
          "state": { "type": "string", "enum": ["active", "cleared", "acknowledged", "suppressed", "unknown"] },
          "component_id": { "type": ["string", "null"] },
          "system": { "type": ["string", "null"] },
          "setpoint": { "type": ["number", "null"] },
          "actual_value": { "type": ["number", "null"] },
          "unit": { "type": ["string", "null"] },
          "acknowledged_at": { "type": ["string", "null"], "format": "date-time" },
          "acknowledged_by": { "type": ["string", "null"] }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "missing_fraction": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "clock_sync_ok": { "type": "boolean" },
        "quality_flags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["generated_by"],
      "properties": {
        "generated_by": { "type": "string" }
      }
    }
  }
}
