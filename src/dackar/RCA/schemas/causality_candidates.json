      "type": "object",
      "required": [
        "generated_candidate_count",
        "retained_candidate_count",
        "filtered_out_candidate_count",
        "top_retained_composite_score",
        "retention_mode"
      ],
      "properties": {
        "generated_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "retained_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "filtered_out_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "top_retained_composite_score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "top_filtered_composite_score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "retention_mode": {
          "type": "string",
          "enum": [
            "strict_thresholding",
            "top_k_only",
            "threshold_then_top_k"
          ]
        }
      },
      "additionalProperties": false
    },
    "recurrence_summary": {
      "type": "object",
      "properties": {
        "candidate_count_with_recurrence": { "type": "integer", "minimum": 0 },
        "top_recurrent_candidate_id": { "type": ["string", "null"] },
        "top_recurrent_recurrence_score": { "type": ["number", "null"] },
        "top_recurrent_past_event_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "top_recurrent_mechanism_candidate_id": { "type": ["string", "null"] },
        "top_recurrent_mechanism_recurrence_score": { "type": ["number", "null"] },
        "top_recurrent_mechanism_past_event_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "top_recurrent_historical_candidate_id": { "type": ["string", "null"] },
        "top_recurrent_historical_recurrence_score": { "type": ["number", "null"] },
        "top_recurrent_historical_past_event_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "high_recurrence_candidate_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "common_cause_summary": {
      "type": "object",
      "properties": {
        "suspected_common_cause": { "type": "boolean" },
        "candidate_count_with_common_cause": { "type": "integer", "minimum": 0 },
        "top_common_cause_candidate_id": { "type": ["string", "null"] },
        "top_common_cause_score": { "type": ["number", "null"] },
        "top_common_cause_confidence": {
          "type": ["string", "null"],
          "enum": ["high", "medium", "low", "none", null]
        },
        "clustered_candidate_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "shared_dependency_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
