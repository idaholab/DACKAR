{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "causality_candidates.v3_2.schema.json",
  "title": "causality_candidates.v3_2_runtime",
  "description": "Ranked and screened causal hypotheses for a target event with explicit screening summary and filtered-candidate audit trail.",
  "type": "object",
  "required": [
    "event_id",
    "generated_at",
    "scoring_config",
    "screening",
    "summary",
    "candidates",
    "pipeline_health"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "subgraph_id": {
      "type": ["string", "null"]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "scoring_config": {
      "type": "object",
      "properties": {
        "weights": {
          "type": "object",
          "properties": {
            "structural": { "type": "number", "minimum": 0, "maximum": 1 },
            "temporal": { "type": "number", "minimum": 0, "maximum": 1 },
            "telemetry": { "type": "number", "minimum": 0, "maximum": 1 },
            "evidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "governance": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "required": ["structural", "temporal", "telemetry", "evidence", "governance"],
          "additionalProperties": false
        },
        "tskr_enabled": { "type": "boolean" },
        "minimum_evidence_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "minimum_composite_threshold": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["weights"],
      "additionalProperties": true
    },
    "screening": {
      "type": "object",
      "required": [
        "minimum_evidence_threshold",
        "minimum_composite_threshold",
        "requires_both_thresholds",
        "top_k_candidates",
        "retention_mode"
      ],
      "properties": {
        "minimum_evidence_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimum_composite_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "requires_both_thresholds": {
          "type": "boolean"
        },
        "top_k_candidates": {
          "type": "integer",
          "minimum": 1
        },
        "retention_mode": {
          "type": "string",
          "enum": [
            "strict_thresholding",
            "top_k_only",
            "threshold_then_top_k"
          ]
        },
        "review_alternative_notes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "screening_notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "generated_candidate_count",
        "retained_candidate_count",
        "filtered_out_candidate_count",
        "top_retained_composite_score",
        "retention_mode"
      ],
      "properties": {
        "generated_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "retained_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "filtered_out_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "top_retained_composite_score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "top_filtered_composite_score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "retention_mode": {
          "type": "string",
          "enum": [
            "strict_thresholding",
            "top_k_only",
            "threshold_then_top_k"
          ]
        }
      },
      "additionalProperties": false
    },
    "recurrence_summary": {
      "type": "object",
      "properties": {
        "candidate_count_with_recurrence": { "type": "integer", "minimum": 0 },
        "top_recurrent_candidate_id": { "type": ["string", "null"] },
        "top_recurrent_recurrence_score": { "type": ["number", "null"] },
        "top_recurrent_past_event_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "top_recurrent_mechanism_candidate_id": { "type": ["string", "null"] },
        "top_recurrent_mechanism_recurrence_score": { "type": ["number", "null"] },
        "top_recurrent_mechanism_past_event_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "top_recurrent_historical_candidate_id": { "type": ["string", "null"] },
        "top_recurrent_historical_recurrence_score": { "type": ["number", "null"] },
        "top_recurrent_historical_past_event_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "high_recurrence_candidate_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "common_cause_summary": {
      "type": "object",
      "properties": {
        "suspected_common_cause": { "type": "boolean" },
        "candidate_count_with_common_cause": { "type": "integer", "minimum": 0 },
        "top_common_cause_candidate_id": { "type": ["string", "null"] },
        "top_common_cause_score": { "type": ["number", "null"] },
        "top_common_cause_confidence": {
          "type": ["string", "null"],
          "enum": ["high", "medium", "low", "none", null]
        },
        "clustered_candidate_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "shared_dependency_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "hypothesis_type",
          "cause_node_id",
          "cause_label",
          "target_event_id",
          "kg_path",
          "scores",
          "composite_score",
          "meets_evidence_threshold"
        ],
        "properties": {
          "candidate_id": {
            "type": "string"
          },
          "hypothesis_type": {
            "type": "string",
            "enum": [
              "failure_mode",
              "historical_event",
              "component_fault",
              "procedure_deviation",
              "maintenance_factor",
              "external_factor",
              "unknown"
            ]
          },
          "cause_node_id": {
            "type": "string"
          },
          "cause_label": {
            "type": "string"
          },
          "target_event_id": {
            "type": "string"
          },
          "kg_path": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["node_id", "node_type"],
              "properties": {
                "node_id": { "type": "string" },
                "node_type": { "type": "string" },
                "label": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "kg_edges": {
            "type": "array",
            "items": { "type": "string" }
          },
          "scores": {
            "type": "object",
            "properties": {
              "structural": { "type": "number", "minimum": 0, "maximum": 1 },
              "temporal": { "type": "number", "minimum": 0, "maximum": 1 },
              "telemetry": { "type": "number", "minimum": 0, "maximum": 1 },
              "evidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "governance": { "type": "number", "minimum": 0, "maximum": 1 },
              "tskr_pattern_match": { "type": "number", "minimum": 0, "maximum": 1 },
              "temporal_precedence": { "type": "number", "minimum": 0, "maximum": 1 },
              "latency_consistency": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": ["structural", "temporal", "telemetry", "evidence", "governance"],
            "additionalProperties": true
          },
          "score_rationale": {
            "type": "object",
            "properties": {
              "structural": { "type": "string" },
              "temporal": { "type": "string" },
              "telemetry": { "type": "string" },
              "evidence": { "type": "string" },
              "governance": { "type": "string" }
            },
            "additionalProperties": false
          },
          "composite_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence_label": {
            "type": "string",
            "enum": ["high", "medium", "low", "speculative"]
          },
          "supporting_evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
            "contradicting_evidence_refs": {
              "type": "array",
              "items": { "type": "string" }
            },
            "contextual_evidence_refs": {
              "type": "array",
              "items": { "type": "string" }
            },
            "evidence_posture": {
              "type": "string",
              "enum": ["supported", "mixed", "contextual_only", "contradicted", "weak"]
            },
            "temporal_posture": {
              "type": "string",
              "enum": ["supported", "partial", "contradicted", "weak"]
            },
            "recurrence": {
              "type": "object",
              "properties": {
                "same_failure_mode_event_count": { "type": "integer", "minimum": 0 },
                "same_component_event_count": { "type": "integer", "minimum": 0 },
                "same_asset_event_count": { "type": "integer", "minimum": 0 },
                "matched_past_event_ids": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "recurrence_score": { "type": "number" },
                "recurrence_confidence": {
                  "type": "string",
                  "enum": ["high", "medium", "low", "none"]
                }
              },
              "additionalProperties": false
            },
            "common_cause": {
              "type": "object",
              "properties": {
                "shared_dependency_ids": { "type": "array", "items": { "type": "string" } },
                "affected_component_ids": { "type": "array", "items": { "type": "string" } },
                "converging_candidate_ids": { "type": "array", "items": { "type": "string" } },
                "shared_dependency_signal": { "type": "number" },
                "shared_upstream_signal": { "type": "number" },
                "symptom_convergence_signal": { "type": "number" },
                "governance_commonality_signal": { "type": "number" },
                "common_cause_score": { "type": "number" },
                "common_cause_confidence": { "type": "string", "enum": ["high", "medium", "low", "none"] }
              },
              "additionalProperties": false
            },
            "retained_as_review_alternative": {
              "type": "boolean"
            },
          "temporal_evidence": {
            "type": "object",
            "properties": {
              "tskr_rule_ids": {
                "type": "array",
                "items": { "type": "string" }
              },
              "matching_signal_ids": {
                "type": "array",
                "items": { "type": "string" }
              },
              "window_start": {
                "type": ["string", "null"],
                "format": "date-time"
              },
              "window_end": {
                "type": ["string", "null"],
                "format": "date-time"
              },
              "relation": {
                "type": "string",
                "enum": ["simultaneous", "precedes", "follows", "unordered", "unknown"]
              },
              "operator_family": {
                "type": ["string", "null"],
                "enum": [null, "interval_interval", "interval_point", "point_point"]
              },
              "mean_lag_hours": {
                "type": ["number", "null"]
              },
              "support": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1
              },
              "pattern_id": {
                "type": ["string", "null"]
              },
              "expected_latency_min_hours": { "type": ["number", "null"] },
              "expected_latency_max_hours": { "type": ["number", "null"] },
              "observed_lag_hours": { "type": ["number", "null"] },
              "latency_violation_type": {
                "type": ["string", "null"],
                "enum": ["none", "too_fast", "too_slow", "unknown", null]
              },
              "temporal_contradiction": { "type": ["boolean", "null"] }
            },
            "additionalProperties": true
          },
          "assumptions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "meets_evidence_threshold": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          },
          "temporal_relation": {
            "type": ["string", "null"]
          },
          "telemetry_evidence": {
            "type": "object",
            "properties": {
              "signal_count": { "type": "integer", "minimum": 0 },
              "matching_signal_ids": {
                "type": "array",
                "items": { "type": "string" }
              },
              "anomaly_window": {
                "type": "object"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    "filtered_out_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "hypothesis_type",
          "cause_label",
          "composite_score",
          "meets_evidence_threshold",
          "filter_reason"
        ],
        "properties": {
          "candidate_id": {
            "type": "string"
          },
          "hypothesis_type": {
            "type": "string",
            "enum": [
              "failure_mode",
              "historical_event",
              "component_fault",
              "procedure_deviation",
              "maintenance_factor",
              "external_factor",
              "unknown"
            ]
          },
          "cause_label": {
            "type": "string"
          },
          "composite_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "meets_evidence_threshold": {
            "type": "boolean"
          },
          "filter_reason": {
            "type": "string",
            "enum": [
              "below_composite_threshold",
              "below_evidence_threshold",
              "below_composite_and_evidence_threshold",
              "excluded_by_top_k"
            ]
            },
            "recurrence_score": { "type": "number" },
            "recurrence_confidence": {
              "type": "string",
              "enum": ["high", "medium", "low", "none"]
            },
            "matched_past_event_ids": {
              "type": "array",
              "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "code_version": {
          "type": "string"
        },
        "tskr_enabled": { "type": ["boolean", "null"] },
        "evidence_refinement_applied": { "type": ["boolean", "null"] }
      },
      "additionalProperties": true
    },
    "pipeline_health": {
      "type": "object",
      "required": ["status", "issues"],
      "properties": {
        "status": { "type": "string", "enum": ["green", "yellow", "red"] },
        "issues": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}