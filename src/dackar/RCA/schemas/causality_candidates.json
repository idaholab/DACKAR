          "notes": {
            "type": "string"
          },
          "temporal_relation": {
            "type": ["string", "null"]
          },
          "telemetry_evidence": {
            "type": "object",
            "properties": {
              "signal_count": { "type": "integer", "minimum": 0 },
              "matching_signal_ids": {
                "type": "array",
                "items": { "type": "string" }
              },
              "anomaly_window": {
                "type": "object"
              }
            },
            "additionalProperties": true
          }
        },
