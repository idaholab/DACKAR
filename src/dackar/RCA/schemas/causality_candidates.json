{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "causality_candidates.v3_2.schema.json",
  "title": "causality_candidates.v3_2_runtime",
  "description": "Ranked and screened causal hypotheses for a target event with explicit screening summary and filtered-candidate audit trail.",
  "type": "object",
  "required": [
    "event_id",
    "generated_at",
    "scoring_config",
    "screening",
    "summary",
    "candidates",
    "pipeline_health"
  ],
