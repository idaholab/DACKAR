        "minimum_composite_threshold",
        "requires_both_thresholds",
        "top_k_candidates",
        "retention_mode"
      ],
      "properties": {
        "minimum_evidence_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimum_composite_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "requires_both_thresholds": {
          "type": "boolean"
        },
        "top_k_candidates": {
          "type": "integer",
          "minimum": 1
