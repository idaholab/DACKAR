              "causal_category": {
                "type": "string",
                "enum": ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K", "L"]
              },
              "chain_position": {
                "type": "string",
                "enum": ["initiating", "contributing", "consequence"]
              }
            },
            "additionalProperties": false
          },
          "canonical_candidate_key": {
            "type": "string"
          },
          "component_id": {
            "type": "string"
          },
          "failure_mode_id": {
            "type": "string"
          },
          "primary_causal_category": {
            "type": "string",
            "enum": ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K", "L"]
