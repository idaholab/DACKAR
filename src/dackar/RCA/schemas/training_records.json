{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TrainingRecords",
  "description": "Training qualification and recency records used for human/organizational contributor assessment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["training_context_id", "event_id", "generated_at", "records"],
  "properties": {
    "training_context_id": { "type": "string" },
    "event_id": { "type": "string" },
    "asset_id": { "type": ["string", "null"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "person_id", "role", "course_id", "completion_date", "qualification_status"],
        "properties": {
          "record_id": { "type": "string" },
          "person_id": { "type": "string" },
          "role": { "type": "string" },
          "organization_unit": { "type": ["string", "null"] },
          "course_id": { "type": "string" },
          "course_title": { "type": ["string", "null"] },
          "completion_date": { "type": "string", "format": "date-time" },
          "expires_at": { "type": ["string", "null"], "format": "date-time" },
          "qualification_status": { "type": "string", "enum": ["current", "expired", "incomplete", "waived", "unknown"] },
          "assessment_score": { "type": ["number", "null"] },
          "related_systems": { "type": "array", "items": { "type": "string" } },
          "related_procedures": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coverage_status": { "type": "string", "enum": ["complete", "partial", "missing"] },
        "quality_flags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["generated_by"],
      "properties": {
        "generated_by": { "type": "string" }
      }
    }
  }
}
