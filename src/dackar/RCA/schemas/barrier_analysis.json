{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BarrierAnalysis",
  "description": "Structured barrier-state analysis derived from RCA artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["analysis_id", "event_id", "generated_at", "barriers", "summary", "provenance"],
  "properties": {
    "analysis_id": { "type": "string" },
    "event_id": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "barriers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["barrier_id", "barrier_label", "barrier_type", "status", "linked_candidate_ids"],
        "properties": {
          "barrier_id": { "type": "string" },
          "barrier_label": { "type": "string" },
          "barrier_type": { "type": "string", "enum": ["safety_function", "procedural", "physical", "administrative"] },
          "status": { "type": "string", "enum": ["intact", "degraded", "failed", "unknown"] },
          "linked_candidate_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall_status", "barrier_count", "degraded_barrier_count"],
      "properties": {
        "overall_status": { "type": "string", "enum": ["green", "yellow", "red"] },
        "barrier_count": { "type": "integer", "minimum": 0 },
        "degraded_barrier_count": { "type": "integer", "minimum": 0 },
        "evidence_result_count": { "type": "integer", "minimum": 0 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["generated_by"],
      "properties": {
        "generated_by": { "type": "string" }
      }
    }
  }
}
