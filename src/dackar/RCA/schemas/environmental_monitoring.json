{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EnvironmentalMonitoring",
  "description": "Environmental and external disturbance records that may influence RCA Category F candidates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["environmental_context_id", "event_id", "asset_id", "window", "generated_at", "records"],
  "properties": {
    "environmental_context_id": { "type": "string" },
    "event_id": { "type": "string" },
    "asset_id": { "type": ["string", "null"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record_id", "timestamp", "record_type"],
        "properties": {
          "record_id": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" },
          "record_type": {
            "type": "string",
            "enum": ["ambient_temperature", "ambient_humidity", "flooding", "seismic", "fire", "grid_disturbance", "emi", "other"]
          },
          "location": { "type": ["string", "null"] },
          "severity": { "type": ["string", "null"], "enum": ["low", "medium", "high", "critical", "unknown", null] },
          "value": { "type": ["number", "null"] },
          "unit": { "type": ["string", "null"] },
          "duration_seconds": { "type": ["integer", "null"], "minimum": 0 },
          "description": { "type": "string" },
          "source_system": { "type": ["string", "null"] }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coverage_status": { "type": "string", "enum": ["complete", "partial", "missing"] },
        "quality_flags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["generated_by"],
      "properties": {
        "generated_by": { "type": "string" }
      }
    }
  }
}
