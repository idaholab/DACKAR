{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "causality_candidates.v3_2.schema.json",
  "title": "CausalityCandidatesV32",
  "description": "Ranked and screened causal hypotheses for a target event with explicit screening summary and filtered-candidate audit trail.",
  "type": "object",
  "required": [
    "event_id",
    "generated_at",
    "scoring_config",
    "screening",
    "summary",
    "candidates"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "subgraph_id": {
      "type": ["string", "null"]
    },
    "metamodel_compliance": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["partial", "full"]
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "category_coverage": {
      "type": "object",
      "description": "Coverage summary keyed by causal category A-L.",
      "additionalProperties": false,
      "properties": {
        "A": { "$ref": "#/definitions/category_status" },
        "B": { "$ref": "#/definitions/category_status" },
        "C": { "$ref": "#/definitions/category_status" },
        "D": { "$ref": "#/definitions/category_status" },
        "E": { "$ref": "#/definitions/category_status" },
        "F": { "$ref": "#/definitions/category_status" },
        "G": { "$ref": "#/definitions/category_status" },
        "H": { "$ref": "#/definitions/category_status" },
        "I": { "$ref": "#/definitions/category_status" },
        "J": { "$ref": "#/definitions/category_status" },
        "K": { "$ref": "#/definitions/category_status" },
        "L": { "$ref": "#/definitions/category_status" }
      }
    },
    "applicability_assessment": {
      "type": "object",
      "description": "Applicability assessment keyed by causal category A-L.",
      "additionalProperties": false,
      "properties": {
        "A": { "$ref": "#/definitions/applicability_status" },
        "B": { "$ref": "#/definitions/applicability_status" },
        "C": { "$ref": "#/definitions/applicability_status" },
        "D": { "$ref": "#/definitions/applicability_status" },
        "E": { "$ref": "#/definitions/applicability_status" },
        "F": { "$ref": "#/definitions/applicability_status" },
        "G": { "$ref": "#/definitions/applicability_status" },
        "H": { "$ref": "#/definitions/applicability_status" },
        "I": { "$ref": "#/definitions/applicability_status" },
        "J": { "$ref": "#/definitions/applicability_status" },
        "K": { "$ref": "#/definitions/applicability_status" },
        "L": { "$ref": "#/definitions/applicability_status" }
      }
    },
    "applicability_summary": {
      "type": "object",
      "additionalProperties": true
    },
    "uncertainty_summary": {
      "type": "object",
      "additionalProperties": true
    },
    "decision_posture": {
      "type": "object",
      "additionalProperties": true
    },
    "external_oe_unavailable": {
      "type": "boolean"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "scoring_config": {
      "type": "object",
      "properties": {
        "weights": {
          "type": "object",
          "properties": {
            "structural": { "type": "number", "minimum": 0, "maximum": 1 },
            "temporal": { "type": "number", "minimum": 0, "maximum": 1 },
            "telemetry": { "type": "number", "minimum": 0, "maximum": 1 },
            "evidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "governance": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "required": ["structural", "temporal", "telemetry", "evidence", "governance"],
          "additionalProperties": false
        },
        "tskr_enabled": { "type": "boolean" },
        "minimum_evidence_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "minimum_composite_threshold": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["weights"],
      "additionalProperties": true
    },
    "screening": {
      "type": "object",
      "required": [
        "minimum_evidence_threshold",
        "minimum_composite_threshold",
        "requires_both_thresholds",
        "top_k_candidates",
        "retention_mode"
      ],
      "properties": {
        "minimum_evidence_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "minimum_composite_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "requires_both_thresholds": {
          "type": "boolean"
        },
        "top_k_candidates": {
          "type": "integer",
          "minimum": 1
        },
        "retention_mode": {
          "type": "string",
          "enum": [
            "strict_thresholding",
            "top_k_only",
            "threshold_then_top_k"
          ]
        },
        "screening_notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "generated_candidate_count",
        "retained_candidate_count",
        "filtered_out_candidate_count",
        "top_retained_composite_score",
        "retention_mode"
      ],
      "properties": {
        "generated_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "retained_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "filtered_out_candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "top_retained_composite_score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "top_filtered_composite_score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "retention_mode": {
          "type": "string",
          "enum": [
            "strict_thresholding",
            "top_k_only",
            "threshold_then_top_k"
          ]
        }
      },
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "hypothesis_type",
          "cause_node_id",
          "cause_label",
          "target_event_id",
          "kg_path",
          "scores",
          "composite_score",
          "meets_evidence_threshold"
        ],
        "properties": {
          "candidate_id": {
            "type": "string"
          },
          "canonical_tuple": {
            "type": "object",
            "required": ["component", "failure_mode", "causal_category", "chain_position"],
            "properties": {
              "component": { "type": "string" },
              "failure_mode": { "type": "string" },
              "causal_category": {
                "type": "string",
                "enum": ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K", "L"]
              },
              "chain_position": {
                "type": "string",
                "enum": ["initiating", "contributing", "consequence"]
              }
            },
            "additionalProperties": false
          },
          "canonical_candidate_key": {
            "type": "string"
          },
          "component_id": {
            "type": "string"
          },
          "failure_mode_id": {
            "type": "string"
          },
          "primary_causal_category": {
            "type": "string",
            "enum": ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K", "L"]
          },
          "chain_position": {
            "type": "string",
            "enum": ["initiating", "contributing", "consequence"]
          },
          "chain_position_confidence": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "event_scope_id": {
            "type": ["string", "null"]
          },
          "category_assignment_method": {
            "type": "string",
            "enum": ["deterministic", "llm_fallback", "analyst_override"]
          },
          "category_assignment_confidence": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "category_assignment_rationale": {
            "type": "string"
          },
          "category_alternatives": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K", "L"]
            }
          },
          "category_applicability": {
            "type": "string",
            "enum": ["applicable", "not_applicable", "unknown"]
          },
          "chain_position_rationale": {
            "type": "string"
          },
          "evidence_minima_met": {
            "type": "boolean"
          },
          "evidence_minima_missing": {
            "type": "array",
            "items": { "type": "string" }
          },
          "stream_quality": {
            "type": "object",
            "properties": {
              "temporal": { "type": "number", "minimum": 0, "maximum": 1 },
              "logical": { "type": "number", "minimum": 0, "maximum": 1 },
              "documentary": { "type": "number", "minimum": 0, "maximum": 1 },
              "oe": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          },
          "quality_multiplier": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "data_limited_conclusion": {
            "type": "boolean"
          },
          "critical_streams_below_floor": {
            "type": "array",
            "items": { "type": "string" }
          },
          "primary_eligibility": {
            "type": "string",
            "enum": ["eligible", "blocked"]
          },
          "primary_block_reasons": {
            "type": "array",
            "items": { "type": "string" }
          },
          "review_required_contradiction": {
            "type": "boolean"
          },
          "near_tie_with": {
            "type": "array",
            "items": { "type": "string" }
          },
          "reinstatement_status": {
            "type": "string",
            "enum": ["none", "reinstated_by_oe", "reinstated_by_analyst"]
          },
          "hard_gates": {
            "type": "object",
            "properties": {
              "physical_plausibility": {
                "type": "object",
                "properties": {
                  "passed": { "type": "boolean" },
                  "rationale": { "type": "string" },
                  "gate_order": { "type": "integer", "minimum": 1 }
                },
                "required": ["passed", "rationale"],
                "additionalProperties": true
              },
              "timeline_consistency": {
                "type": "object",
                "properties": {
                  "passed": { "type": "boolean" },
                  "degraded_mode": { "type": "boolean" },
                  "rationale": { "type": "string" },
                  "gate_order": { "type": "integer", "minimum": 1 }
                },
                "required": ["passed", "rationale"],
                "additionalProperties": true
              },
              "barrier_logic": {
                "type": "object",
                "properties": {
                  "passed": { "type": "boolean" },
                  "degraded_mode": { "type": "boolean" },
                  "rationale": { "type": "string" },
                  "gate_order": { "type": "integer", "minimum": 1 }
                },
                "required": ["passed", "rationale"],
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          },
          "ruleout": {
            "type": "object",
            "properties": {
              "reason_code": {
                "type": "string",
                "enum": [
                  "physically_impossible",
                  "timeline_inconsistent",
                  "barrier_held",
                  "no_supporting_data",
                  "category_not_applicable",
                  "outside_investigation_scope",
                  "superseded_by_higher_fidelity_evidence",
                  "analyst_excluded"
                ]
              },
              "reason_detail": { "type": "string" },
              "ruled_out_by": {
                "type": "string",
                "enum": ["engine", "analyst"]
              },
              "ruled_out_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          },
          "hypothesis_type": {
            "type": "string",
            "enum": [
              "failure_mode",
              "historical_event",
              "component_fault",
              "procedure_deviation",
              "maintenance_factor",
              "external_factor",
              "unknown"
            ]
          },
          "cause_node_id": {
            "type": "string"
          },
          "cause_label": {
            "type": "string"
          },
          "target_event_id": {
            "type": "string"
          },
          "kg_path": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["node_id", "node_type"],
              "properties": {
                "node_id": { "type": "string" },
                "node_type": { "type": "string" },
                "label": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "kg_edges": {
            "type": "array",
            "items": { "type": "string" }
          },
          "contradicting_evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "contextual_evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence_posture": {
            "type": "string",
            "enum": ["supported", "mixed", "contextual_only", "contradicted", "weak", "no_data"]
          },
          "temporal_posture": {
            "type": "string",
            "enum": ["supported", "partial", "contradicted", "weak"]
          },
          "scores": {
            "type": "object",
            "properties": {
              "structural": { "type": "number", "minimum": 0, "maximum": 1 },
              "temporal": { "type": "number", "minimum": 0, "maximum": 1 },
              "telemetry": { "type": "number", "minimum": 0, "maximum": 1 },
              "evidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "governance": { "type": "number", "minimum": 0, "maximum": 1 },
              "tskr_pattern_match": { "type": "number", "minimum": 0, "maximum": 1 },
              "temporal_precedence": { "type": "number", "minimum": 0, "maximum": 1 },
              "latency_consistency": { "type": "number", "minimum": 0, "maximum": 1 },
              "evidence_prior": { "type": "number" },
              "evidence_support": { "type": "number" },
              "evidence_contradiction": { "type": "number" },
              "evidence_context": { "type": "number" },
              "symptom_match": { "type": "number", "minimum": 0, "maximum": 1 },
              "alarm_signal": { "type": "number", "minimum": 0, "maximum": 1 },
              "rpn_prior": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "required": ["structural", "temporal", "telemetry", "evidence", "governance"],
            "additionalProperties": true
          },
          "score_rationale": {
            "type": "object",
            "properties": {
              "structural": { "type": "string" },
              "temporal": { "type": "string" },
              "telemetry": { "type": "string" },
              "evidence": { "type": "string" },
              "governance": { "type": "string" }
            },
            "additionalProperties": false
          },
          "composite_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence_label": {
            "type": "string",
            "enum": ["high", "medium", "low", "speculative"]
          },
          "supporting_evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "temporal_evidence": {
            "type": "object",
            "properties": {
              "tskr_rule_ids": {
                "type": "array",
                "items": { "type": "string" }
              },
              "expected_latency_min_hours": { "type": ["number", "null"] },
              "expected_latency_max_hours": { "type": ["number", "null"] },
              "observed_lag_hours": { "type": ["number", "null"] },
              "lag_is_approximate": { "type": ["boolean", "null"], "description": "True when observed_lag_hours was inferred from hedged language (e.g., 'about 3 hours') rather than a precise measurement." },
              "latency_violation_type": {
                "type": "string",
                "enum": ["none", "too_fast", "too_slow", "unknown"]
              },
              "temporal_contradiction": { "type": "boolean" },
              "matching_signal_ids": {
                "type": "array",
                "items": { "type": "string" }
              },
              "window_start": {
                "type": ["string", "null"],
                "format": "date-time"
              },
              "window_end": {
                "type": ["string", "null"],
                "format": "date-time"
              },
              "relation": {
                "type": "string",
                "enum": ["simultaneous", "precedes", "follows", "unordered", "unknown"]
              },
              "operator_family": {
                "type": ["string", "null"],
                "enum": [null, "interval_interval", "interval_point", "point_point"]
              },
              "mean_lag_hours": {
                "type": ["number", "null"]
              },
              "support": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1
              },
              "pattern_id": {
                "type": ["string", "null"]
              }
            },
            "additionalProperties": true
          },
          "assumptions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "meets_evidence_threshold": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          },
          "temporal_relation": {
            "type": ["string", "null"]
          },
          "telemetry_evidence": {
            "type": "object",
            "properties": {
              "signal_count": { "type": "integer", "minimum": 0 },
              "matching_signal_ids": {
                "type": "array",
                "items": { "type": "string" }
              },
              "anomaly_window": {
                "type": "object"
              }
            },
            "additionalProperties": true
          },
          "affected_safety_functions": {
            "type": "array",
            "description": "Safety functions potentially affected by this causal candidate, derived from kg_context.safety_functions via component linkage.",
            "items": {
              "type": "object",
              "required": ["sf_id", "sf_name"],
              "properties": {
                "sf_id":       { "type": "string" },
                "sf_name":     { "type": "string" },
                "sf_category": { "type": ["string", "null"] },
                "impact_type": {
                  "type": "string",
                  "enum": ["direct", "indirect", "unknown"]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "filtered_out_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "hypothesis_type",
          "cause_label",
          "composite_score",
          "meets_evidence_threshold",
          "filter_reason"
        ],
        "properties": {
          "candidate_id": {
            "type": "string"
          },
          "canonical_tuple": {
            "type": "object",
            "required": ["component", "failure_mode", "causal_category", "chain_position"],
            "properties": {
              "component": { "type": "string" },
              "failure_mode": { "type": "string" },
              "causal_category": {
                "type": "string",
                "enum": ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K", "L"]
              },
              "chain_position": {
                "type": "string",
                "enum": ["initiating", "contributing", "consequence"]
              }
            },
            "additionalProperties": false
          },
          "hard_gates": {
            "type": "object",
            "properties": {
              "physical_plausibility": {
                "type": "object",
                "properties": {
                  "passed": { "type": "boolean" },
                  "rationale": { "type": "string" },
                  "gate_order": { "type": "integer", "minimum": 1 }
                },
                "required": ["passed", "rationale"],
                "additionalProperties": true
              },
              "timeline_consistency": {
                "type": "object",
                "properties": {
                  "passed": { "type": "boolean" },
                  "degraded_mode": { "type": "boolean" },
                  "rationale": { "type": "string" },
                  "gate_order": { "type": "integer", "minimum": 1 }
                },
                "required": ["passed", "rationale"],
                "additionalProperties": true
              },
              "barrier_logic": {
                "type": "object",
                "properties": {
                  "passed": { "type": "boolean" },
                  "degraded_mode": { "type": "boolean" },
                  "rationale": { "type": "string" },
                  "gate_order": { "type": "integer", "minimum": 1 }
                },
                "required": ["passed", "rationale"],
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          },
          "ruleout": {
            "type": "object",
            "properties": {
              "reason_code": {
                "type": "string",
                "enum": [
                  "physically_impossible",
                  "timeline_inconsistent",
                  "barrier_held",
                  "no_supporting_data",
                  "category_not_applicable",
                  "outside_investigation_scope",
                  "superseded_by_higher_fidelity_evidence",
                  "analyst_excluded"
                ]
              },
              "reason_detail": { "type": "string" },
              "ruled_out_by": {
                "type": "string",
                "enum": ["engine", "analyst"]
              },
              "ruled_out_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          },
          "component_id": {
            "type": "string"
          },
          "failure_mode_id": {
            "type": "string"
          },
          "canonical_candidate_key": {
            "type": "string"
          },
          "primary_causal_category": {
            "type": "string",
            "enum": ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K", "L"]
          },
          "chain_position": {
            "type": "string",
            "enum": ["initiating", "contributing", "consequence"]
          },
          "recurrence_score": { "type": "number" },
          "recurrence_confidence": { "type": "string" },
          "matched_past_event_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "hypothesis_type": {
            "type": "string",
            "enum": [
              "failure_mode",
              "historical_event",
              "component_fault",
              "procedure_deviation",
              "maintenance_factor",
              "external_factor",
              "unknown"
            ]
          },
          "cause_label": {
            "type": "string"
          },
          "composite_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "meets_evidence_threshold": {
            "type": "boolean"
          },
          "filter_reason": {
            "type": "string",
            "enum": [
              "below_composite_threshold",
              "below_evidence_threshold",
              "below_composite_and_evidence_threshold",
              "excluded_by_top_k"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "code_version": {
          "type": "string"
        },
        "evidence_refinement_applied": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  },
  "definitions": {
    "category_status": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["candidate_scored", "ruled_out", "not_applicable", "unknown"]
        },
        "rationale": { "type": "string" },
        "candidate_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "applicability_status": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["applicable", "not_applicable", "unknown"]
        },
        "rationale": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}