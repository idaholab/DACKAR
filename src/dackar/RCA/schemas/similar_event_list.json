{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SimilarEventList",
  "description": "Step 2d output: similar events identified at plant, fleet, and industry level. Plant tier queries kg_context.past_events directly; fleet/industry tiers require an injected SimilarEventAdapter backed by a fine-tuned LLM (INPO/EPRI/NRC).",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "events", "provenance"],

  "properties": {

    "status": {
      "type": "string",
      "enum": ["not_implemented", "partial", "complete"],
      "description": "partial = plant tier ran; fleet/industry skipped or degraded. complete = all configured tiers ran without error."
    },

    "query_terms": {
      "type": "object",
      "description": "The query dimensions used to search all tiers (auditability).",
      "additionalProperties": false,
      "properties": {
        "asset_id":          { "type": ["string", "null"] },
        "component_ids":     { "type": "array", "items": { "type": "string" } },
        "failure_mode_ids":  { "type": "array", "items": { "type": "string" } },
        "event_type":        { "type": ["string", "null"] },
        "actuation_type":    { "type": ["string", "null"] }
      }
    },

    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plant_count":       { "type": "integer", "minimum": 0 },
        "fleet_count":       { "type": "integer", "minimum": 0 },
        "industry_count":    { "type": "integer", "minimum": 0 },
        "total_count":       { "type": "integer", "minimum": 0 },
        "degraded_tiers":    { "type": "array", "items": { "type": "string" }, "description": "Tier names that failed or timed out." },
        "any_plant_match":   { "type": "boolean" }
      }
    },

    "events": {
      "type": "array",
      "description": "Scored similar events, merged across all tiers.",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["event_id", "source_level", "confidence_weight"],
        "properties": {
          "event_id":           { "type": "string" },
          "source_level":       { "type": "string", "enum": ["plant", "fleet", "industry"] },
          "confidence_weight":  { "type": "number", "minimum": 0.0, "maximum": 1.0,
                                  "description": "Tier-discounted match score: plant×1.0, fleet×0.80, industry×0.60." },
          "component_id":       { "type": ["string", "null"] },
          "failure_signature":  { "type": ["string", "null"] },
          "source_db":          { "type": ["string", "null"], "description": "e.g. INPO, EPRI, NRC, plant_kg" },
          "date":               { "type": ["string", "null"], "format": "date" },
          "summary":            { "type": ["string", "null"] },
          "actuation_type":     { "type": ["string", "null"] },
          "window_tier":        { "type": ["string", "null"], "enum": ["primary", "extended", "historical", "unknown", null] },
          "root_cause_label":   { "type": ["string", "null"] },
          "resolution":         { "type": ["string", "null"] },
          "lessons_learned_ref":{ "type": ["string", "null"], "description": "SOER/LER number or EPRI report ref." },
          "contributing_categories": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Categories A-L implied by root cause (LLM-predicted for fleet/industry)."
          },
          "match_dimensions": {
            "type": "object",
            "additionalProperties": true,
            "description": "Per-dimension score contributions used to compute confidence_weight.",
            "properties": {
              "component_match":  { "type": "number" },
              "fm_match":         { "type": "number" },
              "event_type_match": { "type": "number" },
              "actuation_match":  { "type": "number" },
              "window_boost":     { "type": "number" },
              "raw_score":        { "type": "number" }
            }
          }
        }
      }
    },

    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "note":           { "type": "string" },
        "generated_by":   { "type": "string" },
        "adapter":        { "type": ["string", "null"] },
        "degraded_tiers": { "type": "array", "items": { "type": "string" } }
      }
    }

  }
}
