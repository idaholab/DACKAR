{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tskr_patterns",
  "type": "object",
  "required": ["event_id", "asset_id", "patterns", "summary", "provenance"],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "asset_id": { "type": "string", "minLength": 1 },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pattern_id",
          "event_id",
          "asset_id",
          "target_type",
          "target_id",
          "relation",
          "support",
          "confidence",
          "source"
        ],
        "properties": {
          "window_start": { "type": ["string", "null"], "format": "date-time" },
          "window_end": { "type": ["string", "null"], "format": "date-time" },
          "duration_hours": { "type": ["number", "null"] },
          "expected_latency_min_hours": { "type": ["number", "null"] },
          "expected_latency_max_hours": { "type": ["number", "null"] },
          "observed_lag_hours": { "type": ["number", "null"] },
          "latency_alignment_score": { "type": "number" },
          "latency_violation_type": {
            "type": "string",
            "enum": ["none", "too_fast", "too_slow", "unknown"]
          },
          "temporal_contradiction": { "type": "boolean" },
          "pattern_id": { "type": "string", "minLength": 1 },
          "event_id": { "type": "string", "minLength": 1 },
          "asset_id": { "type": "string", "minLength": 1 },
          "target_type": {
            "type": "string",
            "enum": ["failure_mode", "component", "event", "procedure", "maintenance_factor"]
          },
          "target_id": { "type": "string", "minLength": 1 },
          "component_id": { "type": ["string", "null"] },
          "relation": {
            "type": "string",
            "enum": ["simultaneous", "precedes", "overlaps", "contains", "during", "follows", "unordered", "unknown"]
          },
          "mean_lag_hours": { "type": ["number", "null"] },
          "std_lag_hours": { "type": ["number", "null"], "minimum": 0.0 },
          "support": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "matching_signal_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "anomaly_count": {
            "type": "integer",
            "minimum": 0
          },
          "lag_consistency": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "source": { "type": "string", "minLength": 1 },
          "operator_family": {
            "type": ["string", "null"],
            "enum": [null, "interval_interval", "interval_point", "point_point"]
          },
          "stage_b_allen_relation": {
            "type": ["string", "null"],
            "enum": [null, "precedes", "overlaps", "contains", "during", "follows", "unknown"]
          },
          "stage_b_temporal_contradiction": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object",
      "required": ["has_temporal_support", "mode"],
      "properties": {
        "has_temporal_support": { "type": "boolean" },
        "mode": { "type": "string", "minLength": 1 },
        "n_patterns": { "type": "integer", "minimum": 0 },
        "dominant_tone": { "type": ["string", "null"] },
        "tone_counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "tone_vocabulary_version": { "type": "string" },
        "tone_calibration_uncertainty": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["generated_by", "generated_at"],
      "properties": {
        "generated_by": { "type": "string", "minLength": 1 },
        "run_id": { "type": ["string", "null"] },
        "generated_at": { "type": "string", "format": "date-time" },
        "tone_vocabulary_version": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}