{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FMEA Ingestion Report",
  "description": "Normalization and quality summary emitted during FMEA ingestion.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "total_fms_ingested",
    "critical_field_missing_count",
    "enrichment_field_missing_count",
    "derived_field_count",
    "nlp_inferred_field_count",
    "orphaned_fm_count",
    "profile_used",
    "format_autodetect_confidence"
  ],
  "properties": {
    "total_fms_ingested": {
      "type": "integer",
      "minimum": 0
    },
    "critical_field_missing_count": {
      "type": "integer",
      "minimum": 0
    },
    "enrichment_field_missing_count": {
      "type": "integer",
      "minimum": 0
    },
    "derived_field_count": {
      "type": "integer",
      "minimum": 0
    },
    "nlp_inferred_field_count": {
      "type": "integer",
      "minimum": 0
    },
    "orphaned_fm_count": {
      "type": "integer",
      "minimum": 0
    },
    "profile_used": {
      "type": "string",
      "enum": [
        "aiag_4th",
        "aiag_5th",
        "mil_std_1629a",
        "iec_60812",
        "nuclear_generic",
        "auto"
      ]
    },
    "format_autodetect_confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  }
}
