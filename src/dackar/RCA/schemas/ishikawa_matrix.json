{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ishikawa_matrix",
  "description": "Structured fishbone-style RCA support matrix produced by the Ishikawa evaluator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "matrix_id",
    "event_id",
    "asset_id",
    "generated_at",
    "categories",
    "summary",
    "provenance"
  ],
  "properties": {
    "matrix_id": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    },
    "asset_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "rows"],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "equipment_hardware",
              "process_procedure",
              "measurement_instrumentation",
              "environment_operating_context",
              "maintenance_human_factors"
            ]
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "factor_id",
                "label",
                "source_artifact",
                "linked_candidate_ids",
                "supporting_evidence_ids",
                "strength",
                "notes",
                "telemetry_signals",
                "category"
              ],
              "properties": {
                "factor_id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "source_artifact": {
                  "type": "string",
                  "enum": [
                    "event",
                    "telemetry_summary",
                    "kg_context",
                    "tskr_patterns",
                    "causality_candidates",
                    "evidence_bundle",
                    "operational_context",
                    "pm_compliance"
                  ]
                },
                "linked_candidate_ids": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "supporting_evidence_ids": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "strength": {
                  "type": ["number", "null"],
                  "minimum": 0,
                  "maximum": 1
                },
                "notes": {
                  "type": ["object", "string", "null"]
                },
                "temporal_relation": {
                  "type": ["string", "null"],
                  "enum": [null, "simultaneous", "precedes", "follows", "unordered", "unknown"]
                },
                "telemetry_signals": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "equipment_hardware",
                    "process_procedure",
                    "measurement_instrumentation",
                    "environment_operating_context",
                    "maintenance_human_factors"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_count", "category_count", "top_candidate_ids"],
      "properties": {
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "category_count": {
          "type": "integer",
          "minimum": 0
        },
        "top_candidate_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_by", "run_id"],
      "properties": {
        "generated_by": {
          "type": "string"
        },
        "run_id": {
          "type": ["string", "null"]
        }
      }
    }
  }
}