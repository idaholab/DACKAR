{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "kg_context.v2.schema.json",
  "title": "KGContext",
  "description": "Knowledge-graph narrowed context for RCA reasoning.",
  "type": "object",
  "required": [
    "event_id",
    "components",
    "upstream_paths",
    "failure_modes",
    "past_events",
    "documents",
    "seed_context"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Target event identifier"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "component_id"
        ],
        "properties": {
          "component_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "asset_id": {
            "type": "string"
          },
          "seed_match_type": {
            "type": "string",
            "enum": [
              "seed",
              "neighbor",
              "telemetry",
              "asset",
              "document",
              "ops_context"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "upstream_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "path",
          "path_strength"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "path": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "edge_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "path_strength": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "failure_modes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fm_id",
          "component_id"
        ],
        "properties": {
          "fm_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "component_id": {
            "type": "string"
          },
          "component_name": {
            "type": "string"
          },
          "superclass": {
            "type": "string"
          },
          "expected_latency_min_hours": {
            "type": "number"
          },
          "expected_latency_max_hours": {
            "type": "number"
          },
          "expected_symptom_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["vibration", "temperature", "pressure", "flow", "noise", "leakage", "electrical", "control_signal", "structural", "other"]
            },
            "description": "Symptom types this failure mode is expected to produce. Matched against event.symptom_signature.symptom_types in structural scoring."
          },
          "expected_anomaly_pattern": {
            "type": "string",
            "enum": ["step_change", "gradual_drift", "spike", "oscillation", "dropout", "sustained_exceedance", "unknown"],
            "description": "Expected telemetry anomaly pattern for this failure mode. Matched against the dominant observed pattern in structural scoring."
          }
        },
        "additionalProperties": false
      }
    },
    "past_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id"
        ],
        "properties": {
          "event_id": {
            "type": "string"
          },
          "asset_id": {
            "type": "string"
          },
          "component_id": {
            "type": "string"
          },
          "timestamp_start": {
            "type": "string",
            "format": "date-time"
          },
          "timestamp_end": {
            "type": "string",
            "format": "date-time"
          },
          "severity": {
            "type": "string"
          },
          "event_type": {
            "type": "string"
          },
          "matched_asset_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "matched_component_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "matched_failure_mode_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "priority_score": {
            "type": "number"
          },
          "time_distance_days": {
            "type": [
              "integer",
              "null"
            ]
          },
          "resolved": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Whether this past event was resolved. Explicit false = unresolved latent condition; null = unknown. Used by TSKRTemporalScorerV1 recurrence analysis."
          }
        },
        "additionalProperties": false
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "doc_id"
        ],
        "properties": {
          "doc_id": {
            "type": "string"
          },
          "doc_type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "revision": {
            "type": "string"
          },
          "matched_asset_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "matched_component_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "priority_score": {
            "type": "number"
          },
          "time_distance_days": {
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "seed_context": {
      "type": "object",
      "required": [
        "asset_ids",
        "monitored_variables",
        "seed_component_ids"
      ],
      "properties": {
        "asset_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "seed_component_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "monitored_variables": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "monitored_variable_id",
              "component_id",
              "matched_on",
              "match_confidence"
            ],
            "properties": {
              "monitored_variable_id": {
                "type": "string"
              },
              "variable": {
                "type": "string"
              },
              "sensor_id": {
                "type": "string"
              },
              "tag_id": {
                "type": "string"
              },
              "source_system": {
                "type": "string"
              },
              "component_id": {
                "type": "string"
              },
              "component_name": {
                "type": "string"
              },
              "relation_type": {
                "type": "string"
              },
              "matched_on": {
                "type": "string",
                "enum": [
                  "monitored_variable_id",
                  "sensor_id",
                  "tag_id",
                  "ID",
                  "aliases"
                ]
              },
              "match_confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "builder": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}