{
  "entities": {
    "activities": "A",
    "emergent_activities": "E",
    "resources": "R",
    "zones": "Z"
  },
  "core_variables": {
    "planned_duration": "p_i",
    "actual_duration": "D_i",
    "start_time": "S_i",
    "finish_time": "F_i",
    "completion_time": "C",
    "baseline_completion": "C0"
  },
  "metrics": {
    "robustness": "P(C <= C0)",
    "resilience": "(C_nr - C_ar) / (C_nr - C0)",
    "duration_error": "(D_i - p_i) / p_i",
    "uncertainty_index": "sigma_i / mu_i",
    "tail_overrun_probability": "P(D_i > p_i)",
    "float_consumption_risk": "P(D_i - p_i > TF_i)",
    "completion_variance": "Var(C)",
    "delay_exceedance": "P(C - C0 > tau)",
    "critical_path_volatility": "1 - P(CP == CP0)",
    "emergent_work_rate": "|E| / (|A| + |E|)",
    "emergent_work_impact": "C - C_base",
    "emergent_absorption_efficiency": "1 - (EWI / sum(D_e))",
    "resource_utilization": "U_r(t) / A_r(t)",
    "resource_scarcity": "max_t utilization",
    "resource_instability": "Var(utilization)",
    "zone_congestion": "active_activities / capacity",
    "congestion_burden": "integral(max(0, congestion-1))",
    "schedule_nervousness": "fraction of activities rescheduled"
  },
  "composite_indices": {
    "ORI": "weighted robustness metrics",
    "OResI": "weighted resilience metrics",
    "IOPI": "lambda * ORI + (1-lambda) * OResI"
  },
  "estimation": {
    "method": "Monte Carlo",
    "steps": [
      "sample durations",
      "sample emergent work",
      "sample resource availability",
      "generate schedule",
      "compute metrics"
    ]
  }
}